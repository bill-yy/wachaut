# ── Stage 1: build (compile TS, keep build toolchain here only) ────────
FROM node:22-bookworm-slim AS builder

# mediasoup native build needs python3/make/g++
RUN apt-get update && apt-get install -y \
    python3 python3-pip make g++ git \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install all dependencies (dev included — tsc is needed to compile).
# npm ci against the committed lockfile keeps builds reproducible: an
# unpinned install once resolved a newer mediasoup whose prebuilt worker
# failed verification mid-build.
COPY apps/sfu/package.json apps/sfu/package-lock.json ./
COPY apps/sfu/tsconfig.json ./
ENV MEDIASOUP_DOWNLOAD_BIN=1
RUN npm ci

# Compile TypeScript → dist/
COPY apps/sfu/src ./src
RUN npm run build

# ── Stage 2: production runtime (minimal) ──────────────────────────────
FROM node:22-bookworm-slim AS runtime

# tini as PID 1 for proper signal forwarding / graceful shutdown,
# plus curl for the healthcheck.
RUN apt-get update && apt-get install -y --no-install-recommends \
    tini curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system appgroup && useradd --system --gid appgroup --no-create-home appuser

WORKDIR /app

# Reuse the builder's node_modules — it already contains the mediasoup
# worker that passed verification with the full toolchain available. A
# fresh `npm install` here would need python/g++ (absent in this minimal
# stage) whenever the prebuilt worker check fails.
COPY --from=builder /app/node_modules ./node_modules
COPY apps/sfu/package.json ./
ENV NODE_ENV=production

# Copy compiled output from builder
COPY --from=builder /app/dist ./dist

USER appuser

EXPOSE 3002
EXPOSE 40000-49999/udp

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:3002/health || exit 1

ENTRYPOINT ["tini", "--"]
CMD ["node", "dist/index.js"]
