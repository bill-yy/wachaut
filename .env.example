# Wachaut — Environment variables for production deployment.
# Copy to .env and fill in real values. NEVER commit the real .env.

# TURN server shared secret (must match between coturn and the SFU).
# Generate with: openssl rand -hex 32
TURN_SECRET=changeme

# TURN URL that clients use to connect (used by the SFU to mint credentials).
TURN_URL=turn:wachaut.billytech.es:3478?transport=udp

# SFU public IP for ICE candidates (the server's external IP).
RTC_ANNOUNCED_IP=

# Allowed CORS origins (comma-separated).
ALLOWED_ORIGINS=https://wachaut.billytech.es

# ── Admin panel (signaling server) ────────────────────────────────────
# JWT signing secret for admin tokens. REQUIRED in production (the server
# refuses to boot without it). Generate with: openssl rand -hex 32
ADMIN_JWT_SECRET=

# Password for the first superadmin, only used when the DB has no users.
# Minimum 10 chars. The account must rotate this password on first login.
ADMIN_BOOTSTRAP_PASSWORD=

# Admin token lifetime (jsonwebtoken format). Default: 8h
#ADMIN_JWT_EXPIRY=8h
