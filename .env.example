# Wachaut — Environment variables for production deployment.
# Copy to .env and fill in real values. NEVER commit the real .env.

# TURN server shared secret (must match between coturn and the SFU).
# Generate with: openssl rand -hex 32
TURN_SECRET=changeme

# TURN URL that clients use to connect (used by the SFU to mint credentials).
TURN_URL=turn:wachaut.billytech.es:3478?transport=udp

# SFU public IP for ICE candidates (the server's external IP).
RTC_ANNOUNCED_IP=

# SFU media port range — MUST match the container's published UDP ports
# exactly (prod compose publishes 40000-40399; the test-env app 20000-2010).
#RTC_MIN_PORT=40000
#RTC_MAX_PORT=40399

# Host uplink ceiling (bps). Keep headroom above the client "high" preset
# (8 Mbps). Default: 10000000
#MAX_INCOMING_BITRATE=10000000

# Allowed CORS origins (comma-separated).
ALLOWED_ORIGINS=https://wachaut.billytech.es

# ── Limits / tuning (signaling server) ────────────────────────────────
# Socket connections per IP (raise for load tests). Default: 8
#MAX_CONNECTIONS_PER_IP=8
# Idle TTL for abandoned rooms / host reconnect grace. Defaults: 4h / 30s
#ROOM_IDLE_TTL_MS=14400000
#HOST_RECONNECT_GRACE_MS=30000
# SQLite path (mount a Docker volume on it!). Default: ./data/wachaut.db
#WACHAUT_DB_PATH=./data/wachaut.db

# ── Admin panel (signaling server) ────────────────────────────────────
# JWT signing secret for admin tokens. REQUIRED in production (the server
# refuses to boot without it). Generate with: openssl rand -hex 32
ADMIN_JWT_SECRET=

# Password for the first superadmin, only used when the DB has no users.
# Minimum 10 chars. The account must rotate this password on first login.
ADMIN_BOOTSTRAP_PASSWORD=

# Admin token lifetime (jsonwebtoken format). Default: 8h
#ADMIN_JWT_EXPIRY=8h

# Shared secret that authenticates error reports between the signaling
# servers and the SFU (the public web beacon does NOT need it).
# Generate with: openssl rand -hex 32
ERRORS_SECRET=

# ── Web Push (optional — auto-generated to data/push-keys.json if unset) ──
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=

# ── Admin email alerts via Resend (optional) ──────────────────────────
#RESEND_API_KEY=
#ADMIN_NOTIFY_EMAIL=
